{
  "name": "dsh-memory-vault",
  "version": "0.1.0",
  "private": true,
  "description": "外挂记忆库：agent 可写不可读；按时间+事件（项目/类别/日期）索引，只有用户在设置→记忆库里明确开放某几条后，agent 才能读到对应记忆。",
  "type": "module",
  "main": "host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "client",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
